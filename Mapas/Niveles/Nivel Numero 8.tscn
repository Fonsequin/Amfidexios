[sub_resource type="GDScript" id="GDScript_yiwov"]
script/source = "extends Area2D

@onready var barra = $\"../../../../../Barra de tiempo/Fondo1/Barra1/AnimationPlayer2\"
@onready var barra2 = $\"../../../../../Barra de tiempo/Fondo1/Barra2/AnimationPlayer2\"
@onready var final = $\"../../../../../Transicion/AnimationPlayer2\"
@onready var personaje2 = $\"../../../../../CharacterBody2D2/AnimationPlayer\"
@onready var personaje1 = $\"../../../../../CharacterBody2D/AnimationPlayer\"
@onready var reinicio = $\"../../../../../Reinicio\"
@onready var tiempo = $\"../../../../../Cronometro\"
@onready var anim1 = $\"../../../../../Plataforma/Plataforma1/Path2D/PathFollow2D/AnimationPlayer\"
@onready var anim2 = $\"../../../../../Plataforma2/Plataforma1/Path2D/PathFollow2D/AnimationPlayer\"

func _on_body_entered(body):
	if body is CharacterBody2D:
		final.play(\"Vtgz\")
		personaje1.play(\"GTVZ\")
		personaje2.play(\"HOLAAAA\")
		barra.stop()
		barra2.stop()
		anim1.stop()
		anim2.stop()
		barra.play(\"GNZ\")
		barra2.play(\"VLT\")
		reinicio.start()
		tiempo.start()
"

