[sub_resource type="GDScript" id="GDScript_5328a"]
script/source = "extends Area2D

@onready var barra = $\"../../../../Barra de tiempo/Fondo1/Barra1/AnimationPlayer\"
@onready var barra2 = $\"../../../../Barra de tiempo/Fondo1/Barra2/AnimationPlayer\"
@onready var final = $\"../../../../Transicion/AnimationPlayer2\"
@onready var personaje2 = $\"../../../../CharacterBody2D2/AnimationPlayer\"
@onready var personaje1 = $\"../../../../CharacterBody2D/AnimationPlayer\"
@onready var reinicio = $\"../../../../Reinicio\"
@onready var tiempo = $\"../../../../Cronometro\"

func _on_body_entered(body):
	if body is CharacterBody2D:
		final.play(\"Vtgz\")
		personaje1.play(\"GTVZ\")
		personaje2.play(\"HOLAAAA\")
		$\"../../../../CharacterBody2D\".draw_end_animation()
		$\"../../../../CharacterBody2D2\".draw_end_animation()
		barra.stop()
		barra2.stop()
		barra.play(\"Animacion\")
		barra2.play(\"RESET\")
		reinicio.start()
		tiempo.start()
"

